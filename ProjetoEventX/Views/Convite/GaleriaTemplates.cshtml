@model ProjetoEventX.Models.ConviteCentralViewModel
@{
    ViewData["Title"] = "Central de Convites";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categorias = Model.Templates.Select(t => t.Categoria).Distinct().OrderBy(c => c).ToList();
}

<div class="container py-4 convite-central">
    <div class="p-4 p-md-5 rounded-4 mb-4 text-white" style="background:linear-gradient(135deg,#7f1d1d,#991b1b,#111827)">
        <h1 class="fw-bold mb-2">Central de Convites</h1>
        <p class="mb-0">Gerencie templates, rascunhos e criações livres do <strong>EventX Editor</strong> para o evento <strong>@Model.NomeEvento</strong>.</p>
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a class="btn btn-light fw-semibold" href="@Url.Action("Editor", "Convite", new { eventoId = Model.EventoId })">Criar no EventX Editor</a>
            <a class="btn btn-outline-light fw-semibold" href="#rascunhos">Continuar rascunho</a>
        </div>
    </div>

    <section class="mb-5">
        <h4 class="fw-bold mb-3">1. Templates em destaque</h4>
        <div class="row g-3">
            @foreach (var t in Model.Templates.Where(x => x.Destaque).Take(12))
            {
                <div class="col-md-3">
                    <div class="card h-100 shadow-sm border-0">
                        <img src="@t.Thumbnail" class="card-img-top" alt="@t.Nome" style="aspect-ratio:3/4; object-fit:cover;" />
                        <div class="card-body">
                            <h6 class="card-title fw-bold">@t.Nome</h6>
                            <p class="mb-1 text-muted small">Categoria: @t.Categoria</p>
                            <p class="mb-3 text-muted small">Estilo: @t.Estilo</p>
                            <a class="btn btn-danger w-100" href="@Url.Action("Editor", "Convite", new { eventoId = Model.EventoId, templateId = t.Id })">Editar no EventX Editor</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="mb-5">
        <h4 class="fw-bold mb-3">2. Categorias</h4>
        @foreach (var categoria in categorias)
        {
            <details class="mb-3" open>
                <summary class="fw-semibold">@categoria</summary>
                <div class="row g-3 mt-1">
                    @foreach (var t in Model.Templates.Where(x => x.Categoria == categoria))
                    {
                        <div class="col-md-3">
                            <div class="border rounded-3 p-2 h-100 bg-white">
                                <img src="@t.Thumbnail" alt="@t.Nome" class="rounded-2 w-100" style="aspect-ratio:3/4; object-fit:cover;" />
                                <div class="pt-2">
                                    <div class="fw-semibold">@t.Nome</div>
                                    <div class="small text-muted">Estilo: Editor Visual</div>
                                    <a class="btn btn-outline-dark btn-sm w-100 mt-2" href="@Url.Action("Editor", "Convite", new { eventoId = Model.EventoId, templateId = t.Id })">Editar no EventX Editor</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </details>
        }
    </section>

    <section class="mb-5" id="rascunhos">
        <h4 class="fw-bold mb-3">3. Rascunhos recentes</h4>
        @if (Model.RascunhosRecentes.Any())
        {
            <div class="row g-3">
                @foreach (var r in Model.RascunhosRecentes)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h6 class="fw-bold">@r.NomeRascunho</h6>
                                <p class="text-muted small mb-1">Editado em: @r.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="text-muted small mb-3">Template: @(r.TemplateId?.ToString() ?? "Criação do zero")</p>
                                <a class="btn btn-dark w-100" href="@Url.Action("Editor", "Convite", new { eventoId = Model.EventoId, rascunhoId = r.Id })">Continuar rascunho</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary">Nenhum rascunho salvo ainda.</div>
        }
    </section>

    <section class="mb-2">
        <h4 class="fw-bold mb-3">4. Criar do zero</h4>
        <p class="text-muted">Abra uma área em branco no EventX Editor e escolha formato, tamanho e kit inicial.</p>
        <a class="btn btn-lg btn-danger" href="@Url.Action("Editor", "Convite", new { eventoId = Model.EventoId })">Criar no EventX Editor</a>
    </section>
</div>
