@{
    ViewData["Title"] = "EventX Editor";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EventX Editor</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
    <style>
        body{margin:0;background:#0b1220;color:#e5e7eb;font-family:Inter,system-ui}
        .top{height:56px;background:#991b1b;display:flex;align-items:center;justify-content:space-between;padding:0 14px}
        .layout{display:grid;grid-template-columns:260px 1fr 320px;height:calc(100vh - 56px)}
        .left,.right{background:#111827;padding:12px;overflow:auto}.center{display:flex;align-items:center;justify-content:center;background:#1f2937}
        .tool{display:block;width:100%;margin-bottom:8px}
        .canvas-wrap{background:#fff;box-shadow:0 18px 60px rgba(0,0,0,.35)}
    </style>
</head>
<body>
<div class="top">
    <strong>EventX Editor</strong>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-light" onclick="canvas.undo?.()"><i class="fa fa-rotate-left"></i> Desfazer</button>
        <button class="btn btn-sm btn-light" onclick="canvas.redo?.()"><i class="fa fa-rotate-right"></i> Refazer</button>
        <button class="btn btn-sm btn-light" onclick="manualSave()"><i class="fa fa-save"></i> Salvar</button>
        <button class="btn btn-sm btn-light" onclick="openPreview()"><i class="fa fa-eye"></i> Visualizar</button>
        <button class="btn btn-sm btn-light" onclick="exportAs('png')"><i class="fa fa-image"></i> Exportar PNG</button>
        <button class="btn btn-sm btn-light" onclick="window.print()"><i class="fa fa-file-pdf"></i> Exportar PDF</button>
        <button class="btn btn-sm btn-warning" onclick="goSend()"><i class="fa fa-paper-plane"></i> Continuar para envio</button>
    </div>
</div>
<div class="layout">
    <aside class="left">
        <h6>Biblioteca</h6>
        <button class="btn btn-outline-light btn-sm tool" onclick="addText('Título do evento')">Textos</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="addRect()">Formas</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="addText('★')">Ícones</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="addText('🎉')">Emojis</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="document.getElementById('imgUpload').click()">Uploads</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="applyBlock('header')">Bloco: Cabeçalho</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="applyBlock('datetime')">Bloco: Data/Hora</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="applyBlock('location')">Bloco: Local</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="applyBlock('message')">Bloco: Mensagem</button>
        <button class="btn btn-outline-light btn-sm tool" onclick="applyBlock('rsvp')">Bloco: RSVP</button>
        <hr />
        <div class="small text-white-50">Placeholders: {{nomeConvidado}}, {{nomeEvento}}, {{dataEvento}}, {{horaEvento}}, {{localEvento}}</div>
        <input type="file" id="imgUpload" hidden accept="image/*" onchange="uploadImage(event)" />
    </aside>
    <main class="center">
        <div>
            <div class="text-center small mb-2">Área de criação</div>
            <div class="canvas-wrap"><canvas id="editor"></canvas></div>
        </div>
    </main>
    <aside class="right">
        <h6>Propriedades</h6>
        <div class="mb-2"><label>Nome do rascunho</label><input id="draftName" class="form-control form-control-sm" value="@ViewBag.NomeRascunho" /></div>
        <div class="mb-2"><label>Fonte</label><input id="font" class="form-control form-control-sm" value="Inter" /></div>
        <div class="mb-2"><label>Cor</label><input id="color" type="color" class="form-control form-control-color" value="#111111" /></div>
        <div class="mb-2"><label>Opacidade</label><input id="opacity" type="range" class="form-range" min="0" max="1" step="0.05" value="1" /></div>
        <div class="d-grid gap-2">
            <button class="btn btn-outline-light btn-sm" onclick="applyTextProps()">Aplicar estilo</button>
            <button class="btn btn-outline-light btn-sm" onclick="align('left')">Alinhar à esquerda</button>
            <button class="btn btn-outline-light btn-sm" onclick="align('center')">Centralizar</button>
            <button class="btn btn-outline-light btn-sm" onclick="align('right')">Alinhar à direita</button>
            <button class="btn btn-outline-light btn-sm" onclick="duplicate()">Duplicar</button>
            <button class="btn btn-outline-light btn-sm" onclick="toggleLock()">Bloquear/Desbloquear</button>
            <button class="btn btn-outline-light btn-sm" onclick="moveLayer(1)">Trazer para frente</button>
            <button class="btn btn-outline-light btn-sm" onclick="moveLayer(-1)">Enviar para trás</button>
            <button class="btn btn-danger btn-sm" onclick="removeSelected()">Deletar</button>
        </div>
        <hr />
        <div class="row g-2">
            <div class="col"><button class="btn btn-outline-light btn-sm w-100" onclick="preset('vertical')">Vertical</button></div>
            <div class="col"><button class="btn btn-outline-light btn-sm w-100" onclick="preset('horizontal')">Horizontal</button></div>
            <div class="col"><button class="btn btn-outline-light btn-sm w-100" onclick="preset('square')">Quadrado</button></div>
        </div>
    </aside>
</div>

<form id="af" method="post">@Html.AntiForgeryToken()</form>
<script>
const eventoId=@ViewBag.EventoId, templateId=@(ViewBag.TemplateId ?? "null"); let rascunhoId=@(ViewBag.RascunhoId ?? "null");
const layoutRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.LayoutJson));
const eventData={nomeEvento:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.NomeEvento)),dataEvento:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.DataEvento)),horaEvento:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.HoraInicio)),localEvento:@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.NomeLocal))};
let canvas = new fabric.Canvas('editor',{width:900,height:1280,backgroundColor:'#fff'});
try{ if(layoutRaw){ canvas.loadFromJSON(JSON.parse(layoutRaw),()=>canvas.renderAll()); } }catch{}
function addText(t){const o=new fabric.Textbox(t,{left:120,top:120,width:560,fontSize:40,fill:'#111'});canvas.add(o).setActiveObject(o)}
function addRect(){const o=new fabric.Rect({left:100,top:100,width:240,height:120,fill:'#991b1b',rx:10,ry:10});canvas.add(o).setActiveObject(o)}
function applyBlock(type){ if(type==='header') addText('{{nomeEvento}}'); if(type==='datetime') addText('{{dataEvento}} • {{horaEvento}}'); if(type==='location') addText('{{localEvento}}'); if(type==='message') addText('Olá {{nomeConvidado}}, esperamos você!'); if(type==='rsvp') addText('Confirmar presença'); }
function applyTextProps(){const o=canvas.getActiveObject(); if(!o) return; o.set({fill:document.getElementById('color').value,fontFamily:document.getElementById('font').value,opacity:parseFloat(document.getElementById('opacity').value)}); canvas.renderAll();}
function align(side){const o=canvas.getActiveObject(); if(!o) return; if(side==='left')o.set({left:20}); if(side==='center')o.set({left:(canvas.width-o.getScaledWidth())/2}); if(side==='right')o.set({left:canvas.width-o.getScaledWidth()-20}); canvas.renderAll();}
function duplicate(){const o=canvas.getActiveObject(); if(!o) return; o.clone(c=>{c.set({left:o.left+20,top:o.top+20}); canvas.add(c).setActiveObject(c); canvas.renderAll();});}
function removeSelected(){const o=canvas.getActiveObject(); if(o){canvas.remove(o);canvas.renderAll();}}
function moveLayer(step){const o=canvas.getActiveObject(); if(!o) return; step>0?canvas.bringForward(o):canvas.sendBackwards(o); canvas.renderAll();}
function toggleLock(){const o=canvas.getActiveObject(); if(!o) return; const v=!o.selectable; o.selectable=!v; o.evented=!v; canvas.discardActiveObject().renderAll();}
function preset(name){ if(name==='vertical'){canvas.setDimensions({width:900,height:1280});} if(name==='horizontal'){canvas.setDimensions({width:1280,height:900});} if(name==='square'){canvas.setDimensions({width:1080,height:1080});} canvas.renderAll();}
function uploadImage(ev){const f=ev.target.files[0]; if(!f) return; const r=new FileReader(); r.onload=e=>fabric.Image.fromURL(e.target.result,img=>{img.scaleToWidth(300);img.set({left:100,top:100});canvas.add(img).setActiveObject(img)}); r.readAsDataURL(f);}
function hydrate(){ canvas.getObjects().forEach(o=>{ if(o.type==='textbox' || o.type==='text'){ ['nomeEvento','dataEvento','horaEvento','localEvento'].forEach(k=>{ if(o.text?.includes('{{'+k+'}}')) o.text=o.text.replaceAll('{{'+k+'}}',eventData[k]); }); } }); canvas.renderAll();}
hydrate();
function openPreview(){const w=window.open('','_blank'); w.document.write('<img style="width:100%" src="'+canvas.toDataURL({format:'png'})+'"/>');}
function exportAs(){const a=document.createElement('a'); a.href=canvas.toDataURL({format:'png'}); a.download='convite-eventx.png'; a.click();}
async function manualSave(){
 const token=document.querySelector('#af input[name="__RequestVerificationToken"]').value;
 const payload={rascunhoId,eventoId,templateId,nomeRascunho:document.getElementById('draftName').value,layoutJson:JSON.stringify(canvas.toJSON()),previewHtml:'<img src="'+canvas.toDataURL({format:'png'})+'" />'};
 const res=await fetch('@Url.Action("SaveRascunho","Convite")',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':token},body:JSON.stringify(payload)});
 const data=await res.json(); if(data.success){rascunhoId=data.rascunhoId;}
}
async function goSend(){ await manualSave(); if(rascunhoId) location.href='@Url.Action("Enviar","Convite")?eventoId='+eventoId+'&rascunhoId='+rascunhoId; }
setInterval(manualSave,15000);
</script>
</body></html>
