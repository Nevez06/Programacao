@model ProjetoEventX.Models.TemplateConviteEditorViewModel

@{
    ViewData["Title"] = "Editor Visual do Convite";
}

@section Styles {
    <link rel="stylesheet" href="~/css/template-convite-editor.css" asp-append-version="true" />
}

<div class="canva-editor-page">
    <div class="canva-topbar">
        <div>
            <h1>Editor Visual do Convite</h1>
            <p>Template: <strong>@Model.Nome</strong> · Evento: <strong>@Model.NomeEvento</strong></p>
        </div>

        <div class="canva-topbar-actions">
            <button type="button" class="canva-btn" id="btnDuplicate">
                <i class="fas fa-copy"></i> Duplicar
            </button>
            <button type="button" class="canva-btn" id="btnDelete">
                <i class="fas fa-trash"></i> Excluir
            </button>
            <button type="button" class="canva-btn" id="btnUploadImageTop">
                <i class="fas fa-upload"></i> Upload imagem
            </button>
            <button type="button" class="canva-btn" id="btnExportPng">
                <i class="fas fa-file-download"></i> Baixar PNG
            </button>
            <button type="button" class="canva-btn primary" id="btnSave">
                <i class="fas fa-save"></i> Salvar layout
            </button>
        </div>
    </div>

    <div class="canva-layout">
        <aside class="editor-panel">
            <div class="editor-panel-header">
                <h5>Elementos</h5>
                <p>Adicione blocos ao convite</p>
            </div>

            <div class="editor-panel-body">
                <div class="element-list">
                    <button type="button" class="element-btn" data-add="title"><i class="fas fa-heading"></i> Título</button>
                    <button type="button" class="element-btn" data-add="text"><i class="fas fa-font"></i> Texto</button>
                    <button type="button" class="element-btn" data-add="button"><i class="fas fa-square"></i> Botão</button>
                    <button type="button" class="element-btn" data-add="image"><i class="fas fa-image"></i> Imagem</button>
                </div>

                <div class="editor-panel-header section-divider">
                    <h5>Camadas</h5>
                    <p>Elementos no canvas</p>
                </div>

                <div class="editor-panel-body panel-flush">
                    <div class="layers-list" id="layersList"></div>
                </div>
            </div>
        </aside>

        <section>
            <div class="canvas-toolbar">
                <div class="left">
                    <button type="button" class="canva-btn" id="zoomOut"><i class="fas fa-search-minus"></i></button>
                    <button type="button" class="canva-btn" id="zoomReset">100%</button>
                    <button type="button" class="canva-btn" id="zoomIn"><i class="fas fa-search-plus"></i></button>
                </div>

                <div class="right">
                    <button type="button" class="canva-btn" id="toggleGrid"><i class="fas fa-border-all"></i> Grade</button>
                    <button type="button" class="canva-btn" id="bringFront"><i class="fas fa-layer-group"></i> Trazer frente</button>
                    <button type="button" class="canva-btn" id="sendBack"><i class="fas fa-layer-group"></i> Enviar atrás</button>
                </div>
            </div>

            <div class="canvas-stage">
                <div class="canvas-wrap">
                    <div class="invite-canvas" id="inviteCanvas">
                        <div class="canvas-grid" id="canvasGrid"></div>
                    </div>
                </div>
            </div>
        </section>

        <aside class="editor-panel">
            <div class="editor-panel-header">
                <h5>Propriedades</h5>
                <p>Edite o item selecionado</p>
            </div>

            <div class="editor-panel-body">
                <div class="prop-grid">
                    <div class="prop-field">
                        <label>Texto</label>
                        <textarea id="propText" rows="4"></textarea>
                    </div>

                    <div class="prop-inline">
                        <div class="prop-field">
                            <label>Fonte</label>
                            <select id="propFont">
                                <option value="Arial, sans-serif">Arial</option>
                                <option value="'Poppins', sans-serif">Poppins</option>
                                <option value="'Inter', sans-serif">Inter</option>
                                <option value="'Georgia', serif">Georgia</option>
                            </select>
                        </div>
                        <div class="prop-field">
                            <label>Tamanho</label>
                            <input type="number" id="propFontSize" min="10" max="120" />
                        </div>
                    </div>

                    <div class="prop-inline">
                        <div class="prop-field">
                            <label>Cor do texto</label>
                            <input type="color" id="propColor" />
                        </div>
                        <div class="prop-field">
                            <label>Cor de fundo</label>
                            <input type="color" id="propBackground" />
                        </div>
                    </div>

                    <div class="prop-inline">
                        <div class="prop-field">
                            <label>Largura</label>
                            <input type="number" id="propWidth" min="40" />
                        </div>
                        <div class="prop-field">
                            <label>Altura</label>
                            <input type="number" id="propHeight" min="20" />
                        </div>
                    </div>

                    <div class="prop-inline">
                        <div class="prop-field">
                            <label>X</label>
                            <input type="number" id="propX" min="0" />
                        </div>
                        <div class="prop-field">
                            <label>Y</label>
                            <input type="number" id="propY" min="0" />
                        </div>
                    </div>

                    <div class="prop-field">
                        <label>URL da imagem (quando tipo imagem)</label>
                        <input type="text" id="propImageUrl" placeholder="/uploads/convites/arquivo.png" />
                    </div>

                    <div class="prop-field">
                        <button type="button" class="canva-btn full" id="btnUploadImageProperty">
                            <i class="fas fa-upload"></i> Upload imagem para elemento selecionado
                        </button>
                    </div>

                    <div class="editor-panel-header section-divider">
                        <h5>Canvas</h5>
                        <p>Fundo geral</p>
                    </div>

                    <div class="prop-field section-spacer">
                        <label>Cor de fundo do convite</label>
                        <input type="color" id="canvasBackground" value="#ffffff" />
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>

<input type="file" id="imageUploadInput" accept="image/png,image/jpeg,image/webp" hidden />
@Html.AntiForgeryToken()

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/interactjs/dist/interact.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script>
        window.templateEditorConfig = {
            templateId: @Model.TemplateId,
            layoutJson: @Html.Raw(Model.LayoutJson),
            saveLayoutUrl: '@Url.Action("SaveLayout", "TemplateConvite")',
            uploadImageUrl: '@Url.Action("UploadImage", "TemplateConvite")'
        };
    </script>
    <script src="~/js/template-convite-editor.js" asp-append-version="true"></script>
}
