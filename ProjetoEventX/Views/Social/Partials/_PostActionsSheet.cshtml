@model object
<div class="post-actions-overlay js-post-actions-overlay d-none" aria-hidden="true">
    <div class="post-actions-sheet js-post-actions-sheet" role="dialog" aria-modal="true" aria-label="Ações da publicação">
        <div class="post-actions-handle"></div>
        <div class="post-actions-header">
            <strong>Ações da publicação</strong>
            <button type="button" class="post-actions-close js-post-actions-close" aria-label="Fechar">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="post-actions-list js-post-actions-list"></div>
    </div>
</div>

<div class="post-confirm-overlay js-post-confirm-overlay d-none" aria-hidden="true">
    <div class="post-confirm-card" role="dialog" aria-modal="true" aria-label="Confirmar ação">
        <h3 class="post-confirm-title js-post-confirm-title">Confirmar ação</h3>
        <p class="post-confirm-text js-post-confirm-text">Deseja continuar?</p>
        <div class="post-confirm-actions">
            <button type="button" class="post-confirm-btn post-confirm-btn-cancel js-post-confirm-cancel">Cancelar</button>
            <button type="button" class="post-confirm-btn post-confirm-btn-danger js-post-confirm-confirm">Confirmar</button>
        </div>
    </div>
</div>
