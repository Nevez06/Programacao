@model object
<div class="post-actions-overlay js-post-actions-overlay d-none" aria-hidden="true">
    <div class="post-actions-sheet js-post-actions-sheet" role="dialog" aria-modal="true" aria-label="Ações da publicação">
        <div class="post-actions-handle"></div>
        <div class="post-actions-header">
            <strong>Ações da publicação</strong>
            <button type="button" class="post-actions-close js-post-actions-close" aria-label="Fechar">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="post-actions-list js-post-actions-list"></div>
    </div>
</div>
