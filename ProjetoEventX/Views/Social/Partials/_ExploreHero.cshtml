@model ProjetoEventX.ViewModels.Social.ExplorarViewModel
@{
    var heroPrincipal = Model.HeroItems.FirstOrDefault();
    var heroSecundarios = Model.HeroItems.Skip(1).Take(3).ToList();
}

@if (Model.MostrarHero && heroPrincipal != null)
{
    <section class="explore-hero" aria-label="Hero de descoberta">
        <a href="@heroPrincipal.Link" class="explore-hero-main-card is-@heroPrincipal.LayoutVariant">
            <img src="@heroPrincipal.ImagemUrl"
                 alt="@heroPrincipal.Titulo"
                 loading="eager"
                 onerror="this.onerror=null;this.src='/uploads/social/defaults/default-post.svg';" />
            <div class="explore-hero-main-overlay">
                <span class="explore-hero-pill">@heroPrincipal.Badge</span>
                <h2>@heroPrincipal.Titulo</h2>
                @if (!string.IsNullOrWhiteSpace(heroPrincipal.Subtitulo))
                {
                    <p>@heroPrincipal.Subtitulo</p>
                }
            </div>
        </a>

        <div class="explore-hero-side-stack">
            @foreach (var item in heroSecundarios)
            {
                <a href="@item.Link" class="explore-hero-side-card is-@item.LayoutVariant">
                    <img src="@item.ImagemUrl"
                         alt="@item.Titulo"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='/uploads/social/defaults/default-post.svg';" />
                    <div class="explore-hero-side-overlay">
                        <small>@item.Badge</small>
                        <strong>@item.Titulo</strong>
                    </div>
                </a>
            }
        </div>
    </section>
}
