@model ProjetoEventX.ViewModels.Social.ExplorarViewModel

<section class="explore-section" aria-label="Descoberta visual">
    <div class="explore-section-head">
        <h2>Em alta agora</h2>
        <small>@Model.DescobertaVisual.Count itens relevantes</small>
    </div>

    @if (Model.DescobertaVisualInicial.Any())
    {
        <div class="explore-visual-grid js-explore-grid"
             data-explore-load-url="@Url.Action("ExplorarMais", "Social")"
             data-explore-busca="@Model.Busca"
             data-explore-categoria="@Model.CategoriaAtiva"
             data-explore-skip="@Model.ProximoSkip"
             data-explore-take="@Model.LoteCarregamento">
            <partial name="Partials/_ExploreVisualCards" model="Model.DescobertaVisualInicial" />
        </div>

        @if (Model.PodeCarregarMais)
        {
            <div class="explore-load-more-wrap">
                <button type="button" class="explore-load-more-btn js-explore-load-more">
                    Carregar mais
                </button>
            </div>
        }

        <div class="explore-skeleton-grid js-explore-skeleton d-none" aria-hidden="true">
            @for (var i = 0; i < 6; i++)
            {
                <span class="explore-skeleton-card"></span>
            }
        </div>
    }
    else
    {
        <div class="explore-empty-state">
            <h3>Sem resultados no momento</h3>
            <p>Tente ajustar os filtros para descobrir mais conteúdos.</p>
        </div>
    }
</section>

<section class="explore-section" aria-label="Inspirações">
    <div class="explore-section-head">
        <h2>Inspiração do momento</h2>
        <small>tendências para salvar</small>
    </div>

    <div class="explore-inspiration-row explore-moodboard">
        @foreach (var item in Model.Inspiracoes)
        {
            <a href="@item.Link" class="explore-inspiration-card">
                <img src="@item.ImagemUrl"
                     alt="@item.Titulo"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/uploads/social/defaults/default-post.svg';" />
                <div>
                    <strong>@item.Titulo</strong>
                    <small>@item.Categoria</small>
                </div>
            </a>
        }
    </div>
</section>
