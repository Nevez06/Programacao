@model ProjetoEventX.ViewModels.Social.ExplorarViewModel

<section class="explore-section" aria-label="Descoberta visual">
    <div class="explore-section-head">
        <h2>Em alta agora</h2>
        <small>@Model.TotalPostsPopulares posts populares</small>
    </div>

    @if (Model.DescobertaVisual.Any())
    {
        <div class="explore-visual-grid js-explore-grid">
            @foreach (var item in Model.DescobertaVisual.Skip(4))
            {
                var extra = item.Destaque ? "is-featured" : string.Empty;
                <a href="@item.Link" class="explore-visual-card @extra">
                    <img src="@item.ImagemUrl"
                         alt="@item.Titulo"
                         loading="lazy"
                         onerror="this.onerror=null;this.src='/uploads/social/defaults/default-post.svg';" />

                    <span class="explore-badge">@item.Badge</span>
                    @if (item.IsVideo)
                    {
                        <span class="explore-icon-indicator"><i class="fas fa-play"></i></span>
                    }
                    else if (item.IsMulti)
                    {
                        <span class="explore-icon-indicator"><i class="fas fa-clone"></i></span>
                    }

                    <div class="explore-visual-overlay">
                        <strong>@item.Titulo</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitulo))
                        {
                            <small>@item.Subtitulo</small>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="explore-empty-state">
            <h3>Sem resultados no momento</h3>
            <p>Tente ajustar os filtros para descobrir mais conteúdos.</p>
        </div>
    }
</section>

<section class="explore-section" aria-label="Inspirações">
    <div class="explore-section-head">
        <h2>Inspiração do momento</h2>
        <small>tendências para salvar</small>
    </div>

    <div class="explore-inspiration-row explore-moodboard">
        @foreach (var item in Model.Inspiracoes)
        {
            <a href="@item.Link" class="explore-inspiration-card">
                <img src="@item.ImagemUrl"
                     alt="@item.Titulo"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='/uploads/social/defaults/default-post.svg';" />
                <div>
                    <strong>@item.Titulo</strong>
                    <small>@item.Categoria</small>
                </div>
            </a>
        }
    </div>
</section>
