@model ProjetoEventX.ViewModels.Social.FeedPostViewModel

<article class="social-card social-post-card">
    <div class="social-card-header">
        <img src="@Model.FotoPerfilUrl" alt="perfil" class="social-avatar" />
        <div class="social-author-meta">
            <a asp-controller="Social" asp-action="Perfil" asp-route-id="@Model.PerfilId" class="social-author">@Model.NomeAutor</a>
            <small>@Model.TipoPerfil @(!string.IsNullOrWhiteSpace(Model.Cidade) ? $"· {Model.Cidade}" : "") · @Model.DataCriacao.ToLocalTime().ToString("dd/MM HH:mm")</small>
        </div>
        <button type="button" class="social-post-more" aria-label="Mais opções">
            <i class="fas fa-ellipsis-h"></i>
        </button>
    </div>

    <a asp-controller="Social" asp-action="Post" asp-route-id="@Model.PostId" class="social-post-image-link">
        <img src="@Model.ImagemUrl" alt="imagem do post" class="social-post-image social-post-image-lg" />
    </a>

    <div class="social-card-body">
        <div class="social-tags">
            @if (!string.IsNullOrWhiteSpace(Model.Categoria))
            {
                <span class="badge social-pill">@Model.Categoria</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TipoConteudo))
            {
                <span class="badge social-pill social-pill-alt">@Model.TipoConteudo</span>
            }
            @if (Model.EventoId.HasValue)
            {
                <a asp-controller="Social" asp-action="Evento" asp-route-eventoId="@Model.EventoId" class="badge social-pill social-pill-event">@Model.NomeEvento</a>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Localizacao))
            {
                <span class="social-location"><i class="fas fa-location-dot"></i> @Model.Localizacao</span>
            }
        </div>

        <p class="social-caption">@Model.Legenda</p>

        <div class="social-post-stats">
            <strong><span data-like-count="@Model.PostId">@Model.TotalCurtidas</span> curtidas</strong>
            <small><span data-comment-count="@Model.PostId">@Model.TotalComentarios</span> comentários</small>
        </div>

        <div class="social-actions social-actions-strong">
            <form asp-controller="Social" asp-action="AlternarCurtida" asp-route-id="@Model.PostId" method="post" class="js-like-form">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="btn btn-sm @(Model.UsuarioCurtiu ? "btn-danger is-liked" : "btn-outline-danger") js-like-btn"
                        data-post-id="@Model.PostId">
                    <i class="fas fa-heart"></i> <span class="js-like-btn-text">curtir</span>
                </button>
            </form>

            <a asp-controller="Social" asp-action="Post" asp-route-id="@Model.PostId" class="btn btn-sm btn-outline-secondary js-open-post">
                <i class="fas fa-comment"></i> @Model.TotalComentarios
            </a>

            <button type="button" class="btn btn-sm btn-outline-info js-share-btn" data-share-url="@Url.Action("Post", "Social", new { id = Model.PostId }, Context.Request.Scheme)">
                <i class="fas fa-share"></i> compartilhar
            </button>

            @if (Model.UsuarioSalvou)
            {
                <form asp-controller="Social" asp-action="RemoverSalvo" asp-route-id="@Model.PostId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning">
                        <i class="fas fa-bookmark"></i> salvo
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Social" asp-action="SalvarPost" asp-route-id="@Model.PostId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="far fa-bookmark"></i> salvar
                    </button>
                </form>
            }

            <a asp-controller="Social" asp-action="Post" asp-route-id="@Model.PostId" class="btn btn-sm btn-dark">
                abrir
            </a>
        </div>

        @if (Model.ComentariosPreview.Any())
        {
            <div class="social-comment-preview-list">
                @foreach (var comentario in Model.ComentariosPreview)
                {
                    <p><strong>@comentario.NomeAutor</strong> @comentario.Texto</p>
                }
                <a asp-controller="Social" asp-action="Post" asp-route-id="@Model.PostId" class="social-view-comments-link">Ver todos os comentários</a>
            </div>
        }

        <form asp-controller="Social"
              asp-action="ComentarRapido"
              asp-route-id="@Model.PostId"
              method="post"
              class="social-inline-comment-form js-inline-comment-form">
            @Html.AntiForgeryToken()
            <input type="text"
                   name="texto"
                   maxlength="600"
                   class="form-control"
                   placeholder="Adicione um comentário..." />
            <button type="submit" class="btn btn-sm btn-outline-light">Enviar</button>
        </form>
    </div>
</article>
