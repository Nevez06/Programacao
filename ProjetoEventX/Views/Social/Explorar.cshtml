@model ProjetoEventX.ViewModels.Social.ExplorarViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "EventX Social - Explorar";
    ViewData["SocialCurrent"] = "explorar";
}
<section class="explore-social-page">
    <div class="explore-shell">
        <partial name="Partials/_ExploreSearchBar" model="Model" />
        <partial name="Partials/_ExploreChips" model="Model" />
        <partial name="Partials/_ExploreStories" model="Model.StoriesDestaque" />
        <partial name="Partials/_ExploreGrid" model="Model" />
        <partial name="Partials/_ExploreEventCard" model="Model.EventosEmAlta" />
        <partial name="Partials/_ExploreSupplierCard" model="Model.FornecedoresPopulares" />
        <partial name="Partials/_ExploreTemplateCard" model="Model.TemplatesEmAlta" />
    </div>

    <partial name="Partials/_MobileBottomNav" />
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/social-explore.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/social.js" asp-append-version="true"></script>
}
