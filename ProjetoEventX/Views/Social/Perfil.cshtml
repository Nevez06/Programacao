@model ProjetoEventX.ViewModels.Social.PerfilSocialViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "EventX Social - Perfil";
    ViewData["SocialCurrent"] = "perfil";
}

@section Styles {
    <link rel="stylesheet" href="~/css/social.css" asp-append-version="true" />
}

<section class="profile-main-content-shell">
    @Html.AntiForgeryToken()
    <partial name="Partials/_ProfileHeader" model="Model" />
    <partial name="Partials/_ProfileHighlights" model="Model" />
    <partial name="Partials/_ProfileTabs" model="Model" />
    <partial name="Partials/_ProfileGrid" model="Model" />
</section>

@section Scripts {
    <script src="~/js/social.js" asp-append-version="true"></script>
}
