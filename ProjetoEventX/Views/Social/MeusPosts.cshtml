@model IEnumerable<ProjetoEventX.Models.SocialPost>
@{
    ViewData["Title"] = "EventX Social - Meus posts";
}
<link rel="stylesheet" href="~/css/social.css" />

<section class="social-page">
    <header class="social-header">
        <h1>Meus posts</h1>
        <p>organize e destaque seus momentos publicados.</p>
    </header>

    <div class="social-grid social-my-posts-grid">
        @foreach (var post in Model)
        {
            <article class="social-card">
                <img src="@post.ImagemUrl"
                     alt="post @post.Id"
                     class="social-post-image"
                     loading="lazy"
                     onerror="this.onerror=null;this.classList.add('is-broken');this.src='/uploads/social/defaults/default-post.svg';" />
                <div class="social-card-body">
                    <div class="social-tags mb-2">
                        @if (!string.IsNullOrWhiteSpace(post.Categoria))
                        {
                            <span class="badge social-pill">@post.Categoria</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(post.TipoConteudo))
                        {
                            <span class="badge social-pill social-pill-alt">@post.TipoConteudo</span>
                        }
                    </div>
                    <p>@post.Legenda</p>
                    <div class="social-actions">
                        <a asp-action="Post" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">detalhes</a>
                        <a asp-action="EditarPost" asp-route-id="@post.Id" class="btn btn-sm btn-outline-secondary">editar</a>
                        <form asp-action="ExcluirPost" asp-route-id="@post.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">excluir</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
</section>
